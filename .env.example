# Copy this file to .env in the repo root and fill in your keys.
# .env is gitignored: never commit it.
# Format: one NAME=value per line. No quotes, no spaces around "=", no "export".
# `make check` and every test run on a scripted fake model and need no key.

# Required for the eval targets (they always use Groq) and, by default, for `make run`.
# A Groq API key; it starts with "gsk_". Groq's free plan is enough to try the demo.
GROQ_API_KEY=

# Optional: run the assistant (`make run`) on your OpenCode Go subscription instead.
# Paste the API key from opencode.ai/auth, then remove the "# " before the provider line.
OPENCODE_API_KEY=
# MERIDIAN_RUNTIME_PROVIDER=opencode
# The Go model: glm-5.3-flash (the default) or deepseek-v4.1-flash; no other is accepted.
# MERIDIAN_RUNTIME_MODEL=deepseek-v4.1-flash

# Optional. The header value for reading a ticket back in the demo.
# MERIDIAN_STAFF_KEY=dev-staff-key
